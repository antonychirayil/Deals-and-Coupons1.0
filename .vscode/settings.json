{
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/target": true,
    "**/node_modules": true
  },
  "java.configuration.updateBuildConfiguration": "automatic",
  "java.compile.nullAnalysis.mode": "disabled",
  "java.import.exclusions": [
    "**/node_modules/**",
    "**/.metadata/**",
    "**/archetype-resources/**",
    "**/META-INF/maven/**",
    "**/legacy/**"
  ]
}
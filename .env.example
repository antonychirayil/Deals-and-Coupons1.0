# Copy this file to ".env" and fill in real values.
# ".env" is git-ignored, so your real passwords stay on your machine only.

MONGO_ROOT_USERNAME=deals
MONGO_ROOT_PASSWORD=change_me

# auth-service: key used to sign login tokens (JWT). Must be at least 32 characters.
JWT_SECRET=replace_with_a_long_random_string_of_32_or_more_characters

# auth-service: an ADMIN account is created with these at startup
ADMIN_EMAIL=admin@deals.local
ADMIN_PASSWORD=change_me_admin
